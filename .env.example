# Copy to .env beside docker-compose.yml and fill in the values. .env is gitignored.
# Names only here: never commit a real value to this file.

# Required. A fine-grained GitHub token limited to the repositories agents may
# touch. It can push wherever it has reach, so grant read-only access to a repo
# that must never be written, and leave out anything agents have no business in.
# Compose refuses to start without it.
GH_TOKEN=

# Claude authentication. Leave empty to sign in interactively instead: run
# `claude` once inside the container, open the URL it prints in your own
# browser, and paste the code back. The sign-in lives on the fmhome volume and
# survives restarts.
ANTHROPIC_API_KEY=

# ClickUp MCP tools and captain notifications.
CLICKUP_API_KEY=
CLICKUP_TEAM_ID=

# Task that away-mode notifications comment on, and the member mentioned on
# each one so ClickUp sends its alert mail. Without FM_CLICKUP_TASK the
# entrypoint wires no alarm at all.
FM_CLICKUP_TASK=
FM_CLICKUP_MENTION_USER_ID=

# MotherDuck MCP tools. The server runs read-only.
MOTHERDUCK_TOKEN=

# Omni. The allowlist permits sternrisk.omniapp.co for these.
OMNI_API_TOKEN=
OMNI_BASE_URL=

# Optional. Directory seeded into the container as read-only guardrails,
# defaults to ~/.claude. The entrypoint copies CLAUDE.md, settings, keybindings,
# agents/, skills/, and plugins/ out of it on every start. Credentials and
# session transcripts are never copied.
# CLAUDE_SEED_DIR=
